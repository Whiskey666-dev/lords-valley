# Lords Valley Frontend - Variables de entorno (Vite requiere prefijo VITE_)
# Backend Core NestJS
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000/game
# Settlement se resuelve via auth localStorage (access_token + settlementId), VITE_SETTLEMENT_ID solo fallback si no hay login
VITE_SETTLEMENT_ID=
# Frontend dev server (usar: npm run dev -- --port 3001 --host)
# PORT=3001 no es leído por Vite, se pasa por CLI
